# ------------------------------------------------------------------
# 作業時の退避（バックアップ）ファイル
#   差し替え作業の前に元ファイルを "元の名前.YYYYMMDDbak.拡張子" として
#   同じ場所に退避することがあります。これらは公開対象ではないため、
#   git add -A で誤ってコミットされないよう除外します。
#   例) index.html.20260811bak
#       logo_marusho.20260811bak.png
# ------------------------------------------------------------------
*.[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]bak
*.[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]bak.*

# 汎用のバックアップ・一時ファイル
*.bak
*.bak.*
*.orig
*~

# 表示確認用のローカル設定（公開対象ではありません）
.claude/

# OS が自動生成するファイル
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# 書体を作り直すときの元ファイル（1本30MB前後）。
# 公開には使わないので上げません。tools/フォント作成.py が毎回取り直します。
tools/_元ファイル/

# Python が自動で作る中間ファイル
__pycache__/
*.pyc
